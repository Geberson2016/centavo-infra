# Copie para .env (que fica fora do git) e preencha. Gere segredos com: openssl rand -hex 32

# Banco. Num volume já criado, use as mesmas credenciais de quando ele nasceu.
POSTGRES_DB=centavo
POSTGRES_USER=centavo
POSTGRES_PASSWORD=

# Assina os JWT emitidos pela API Spring. Trocar invalida os tokens (e as sessões).
JWT_SECRET=

# Cifra o cookie de sessão do BFF: 32 bytes em hex (openssl rand -hex 32). Trocar derruba as sessões.
SESSION_KEY=

# Portas no host (sempre em 127.0.0.1). Descomente e troque se alguma estiver ocupada.
# POSTGRES_PORT=5433
# BACKEND_PORT=8090
# BFF_PORT=3000
# WEB_PORT=4173
